# Variáveis de Ambiente — Infodesk SmartQuote
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env — apenas este .env.example

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Obtenha em: https://app.supabase.com → Seu Projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ─── GOOGLE GMAIL API ─────────────────────────────────────────────────────────
# Obtenha em: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
